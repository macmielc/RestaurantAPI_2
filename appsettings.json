{
  "AllowedOrigins": [
    "http://localhost:8081"
  ],
  "Authentication": {
    // JwtKey przechowywany w User Secrets lub zmiennych œrodowiskowych PRIVATE_KEY_DON_SHARE_PRIVATE_KEY_DONT_SHARE_MM
    "JwtExpireDays": 15,
    "JwtIssuer": "https://restaurantapi.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}